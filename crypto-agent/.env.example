# Copiá este archivo a .env (o cargá estas variables en Coolify → Environment Variables)

# --- Claude (opcional: narrativa del informe diario) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram (opcional: alertas e informe diario) ---
# Creá el bot con @BotFather y obtené tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API HTTP del agente ---
# Token que se exige en el header "Authorization: Bearer <token>" (generalo con: openssl rand -hex 32)
API_TOKEN=cambiar-este-token

# --- Trading (opcional) ---
# Sin estas variables el agente sólo puede estar en modo pausado o simulado.
# API key de Binance: SOLO permiso "Spot & Margin Trading", SIN retiros, restringida a la IP del VPS.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Interruptor maestro del dinero real: mientras sea false, el modo "live" es imposible.
TRADING_LIVE_ENABLED=false

# --- Almacenamiento ---
# SQLite por defecto (volumen persistente). Para Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:////app/storage/cryptoagent.db

# --- Configuración ---
CONFIG_PATH=/app/config/settings.yaml
LOG_LEVEL=INFO
TZ=America/Argentina/Buenos_Aires
